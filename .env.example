# =============================================================================
#  পরিবেশ ভেরিয়েবল — এই ফাইলটা কপি করে `.env.local` বানান, তারপর আসল মান বসান
#  কপি:  cp .env.example .env.local
#  কখনোই `.env.local` গিটহাবে কমিট করবেন না (.gitignore তে আছে)
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — Project Settings → API Keys থেকে নিন
# -----------------------------------------------------------------------------
# Project URL (উদাহরণ: https://abcdefghijklmn.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...)
# ব্রাউজারে যাবে, তাই এটা গোপন কিছু নয় — নিরাপত্তা আসে RLS থেকে।
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_...)  ⚠️ শুধু সার্ভারে। RLS বাইপাস করে।
# এটা দিয়ে সরাসরি কোয়েরি করার দরকার নেই — শুধু Supabase Storage আপলোডে লাগে।
SUPABASE_SECRET_KEY=

# -----------------------------------------------------------------------------
# সাইট কনফিগারেশন
# -----------------------------------------------------------------------------
# লোকালে http://localhost:3000 , প্রোডাকশনে https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# সাইটের নাম (হেডার, SEO, ইনভয়েসে দেখানো হয়)
NEXT_PUBLIC_STORE_NAME=বইঘর

# -----------------------------------------------------------------------------
# কুরিয়ার (SteadFast) — না দিলেও সাইট পুরোপুরি চলবে
# -----------------------------------------------------------------------------
# না দিলে অ্যাডমিন প্যানেলে "কুরিয়ারে বুক করুন" বাটন নিষ্ক্রিয় থাকবে,
# কিন্তু ট্র্যাকিং কোড হাতে লিখে এবং "কুরিয়ারের জন্য CSV" এক্সপোর্ট করে
# অর্ডার পরিচালনা করা যাবে।
#
# ক্রেডেনশিয়াল কোথায়: https://steadfast.com.bd/ (Merchant Panel → API)
# ⚠️ এগুলো SECRET — NEXT_PUBLIC_ প্রিফিক্স দেবেন না।
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
# ডিফল্ট: https://portal.packzy.com/api/v1 — সাধারণত বদলাতে হয় না
STEADFAST_BASE_URL=

# -----------------------------------------------------------------------------
# Cron সুরক্ষা — কুরিয়ার স্টেটাস স্বয়ংক্রিয়ভাবে সিঙ্ক করার জন্য
# -----------------------------------------------------------------------------
# একটা লম্বা র‍্যান্ডম স্ট্রিং দিন (যেমন: openssl rand -hex 32)
# Vercel → Settings → Environment Variables এ একই নামে বসাতে হয়।
# এই টোকেন ছাড়া /api/cron/courier-sync কেউ কল করতে পারবে না।
CRON_SECRET=

# -----------------------------------------------------------------------------
# ডেভেলপার / ADVANCED
# -----------------------------------------------------------------------------
# নতুন ক্যাশ ডাটা revalidate করার টোকেন।
REVALIDATE_SECRET=
